# Copie este arquivo para ".env" (uso local) e/ou configure os mesmos nomes
# no painel do Railway (produção).
# NUNCA suba o arquivo ".env" pro GitHub nem cole essas chaves em chat/mensagem.

# Chave secreta da PinPay (painel PinPay > Configurações > Chaves de API)
# Use um token PRÓPRIO deste checkout — não reaproveite o de nenhum outro projeto.
PINPAY_TOKEN=sk_live_coloque_sua_chave_aqui

# Secret usado pra validar a assinatura do webhook (painel PinPay > Webhooks)
PINPAY_WEBHOOK_SECRET=whsec_coloque_o_secret_aqui

# URL pública do webhook depois de publicado no Railway. É pra essa URL que a PinPay
# avisa quando um Pix é pago. Cadastre o mesmo endereço no painel PinPay > Webhooks.
PINPAY_WEBHOOK_URL=https://api-biblia-production-4114.up.railway.app/api/webhooks/pinpay

# Domínio(s) onde a página da Bíblia fica publicada, separados por vírgula.
# Sem isso, a API aceita requisição de qualquer origem (funciona, mas é menos seguro).
CORS_ORIGIN=https://selahlivraria.site,https://www.selahlivraria.site

# Token da API da UTMify (painel UTMify > Integrações > Credenciais de API > gerar).
# Com isso o backend registra a venda na UTMify: "waiting_payment" quando o Pix é
# gerado e "paid" quando cai o pagamento — assim a campanha marca a venda e o Meta
# só recebe Purchase no pago (Pix pendente NÃO conta como compra).
# Sem esse token, a integração é ignorada (o checkout continua funcionando).
UTMIFY_API_TOKEN=coloque_seu_token_utmify_aqui

# Porta local (o Railway define a dele automaticamente, não precisa mexer)
PORT=3000
