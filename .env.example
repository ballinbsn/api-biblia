# Copie este arquivo para ".env" (uso local) e/ou configure os mesmos nomes
# no painel do Railway (produção).
# NUNCA suba o arquivo ".env" pro GitHub nem cole essas chaves em chat/mensagem.

# Chave pública da Adex (painel Adex > Chaves API) — pk_live_...
ADEX_PUBLIC_KEY=coloque_sua_chave_publica_aqui

# Chave secreta da Adex (painel Adex > Chaves API) — sk_live_...
# Também é usada pra validar a assinatura HMAC do webhook.
ADEX_SECRET_KEY=coloque_sua_chave_secreta_aqui

# URL pública do webhook depois de publicado no Railway. É pra essa URL que a
# Adex avisa (postbackUrl) quando um Pix muda de status. Se o painel dela
# também tiver um cadastro de webhook separado (Dashboard > Webhooks),
# registre esse MESMO endereço lá também.
ADEX_WEBHOOK_URL=https://SEU-BACKEND-NO-RAILWAY/api/webhooks/adex

# Token da API da UTMify (painel UTMify > aba "Webhooks" > card da DIREITA
# "Credenciais de API" > "Adicionar Credencial" — NÃO o card da esquerda).
# Com isso o backend registra a venda na UTMify: "waiting_payment" quando o Pix é
# gerado e "paid" quando cai o pagamento — assim a campanha marca a venda e o Meta
# só recebe Purchase no pago (Pix pendente NÃO conta como compra).
# Sem esse token, a integração é ignorada (o checkout continua funcionando).
UTMIFY_API_TOKEN=coloque_seu_token_utmify_aqui

# Porta local (o Railway define a dele automaticamente, não precisa mexer)
PORT=3000
